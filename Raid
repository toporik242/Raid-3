        Cham = Cham
    }
end

local function RemoveESP(plr)
    if Esp.Objects[plr] then
        for _, obj in pairs(Esp.Objects[plr]) do 
            if typeof(obj) == "Instance" then
                obj:Destroy()
            else
                obj:Remove()
            end
        end
        Esp.Objects[plr] = nil
    end
end

